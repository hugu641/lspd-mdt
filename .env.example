PORT=3005
# URL Supabase (Connection Pooling - Transaction mode port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL Supabase Directe (Direct connection port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# Clé de signature des sessions (obligatoire en production, ex: `openssl rand -hex 32`)
SESSION_SECRET=""
NEXTAUTH_URL="http://localhost:3005"

# Configuration Discord OAuth2 (Optionnel)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_GUILD_ID=""
