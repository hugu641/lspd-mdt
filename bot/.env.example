# ==========================================
# CONFIGURATION DU BOT DISCORD LSPD (BFA)
# ==========================================

# Clés d'authentification du bot Discord (Portail développeur Discord)
DISCORD_BOT_TOKEN="TON_TOKEN_DE_BOT_ICI"
DISCORD_CLIENT_ID="TON_APPLICATION_ID_ICI"
DISCORD_GUILD_ID="ID_DE_TON_SERVEUR_DISCORD_LSPD"

# Identifiants des salons (ID à copier avec le Mode Développeur Discord activé)
DEFCON_CHANNEL_ID="ID_DU_SALON_DEFCON"
LOGS_CHANNEL_ID="ID_DU_SALON_LOGS_MODERATION"
SALAIRES_CHANNEL_ID="ID_DU_SALON_SALAIRES"

# Rôles autorisés (séparés par une virgule si plusieurs)
ADMIN_ROLE_IDS="ID_ROLE_COMMANDANT,ID_ROLE_CAPITAINE,ID_ROLE_ETAT_MAJOR"
INVITE_BYPASS_ROLE_IDS="ID_ROLE_STAFF,ID_ROLE_COMMANDANT"

# URL du MDT (Mobile Data Terminal)
MDT_URL="http://localhost:3005"
