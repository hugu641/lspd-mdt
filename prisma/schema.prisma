datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Officer {
  id              String   @id @default(cuid())
  badgeNumber     String   @unique
  name            String
  callsign        String
  rank            String   // Rookie, Officier I, ..., Chief of Police
  department      String   @default("LSPD") // LSPD, BCSO, SASP (EMS prévu)
  avatarUrl       String?
  phone           String?
  serviceWeapons  String?  // JSON string: list of assigned service weapons with serial numbers
  status          String   @default("10-10") // 10-8, 10-7, 10-6, 10-10
  unitType        String   @default("Lincoln") // Lincoln, Adam, Tango, Mary, Henry, David, Nora
  isInstructor    Boolean  @default(false)
  isRecruiter     Boolean  @default(false)
  isAdmin         Boolean  @default(false)
  discordId       String?  // ID Discord de l'agent (17-19 chiffres)
  discordTag      String?  // Pseudo / Tag Discord (ex: hugu641)
  createdAt       DateTime @default(now())

  // Relations
  citations       Citation[]
  arrestReports   ArrestReport[]
  warrantsIssued  Warrant[]
  leadCases       Investigation[]
  badges          OfficerBadge[]
  instructedTrainings TrainingSession[]
  registrations   TrainingRegistration[]
  createdCourses  TrainingCourse[]
  candidateReviews RecruitmentCandidate[]
}

model Citizen {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  birthDate       String   // YYYY-MM-DD
  gender          String   @default("M")
  phone           String?
  address         String?
  job             String?  @default("Sans emploi")
  photoUrl        String?
  photos          String?  // JSON string: list of gallery photos [{ id, url, caption, category, createdAt }]
  driverLicense   String   @default("Valide") // Valide, Suspendu, Révoqué, Non titulaire
  weaponLicense   String   @default("Non titulaire") // Valide, Suspendu, Révoqué, Non titulaire
  notes           String?
  dangerLevel     String   @default("Faible") // Faible, Modéré, Élevé, Armé et dangereux
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  citations       Citation[]
  arrestReports   ArrestReport[]
  warrants        Warrant[]
  weapons         RegisteredWeapon[]
  vehicles        RegisteredVehicle[]
}

model PenalCodeItem {
  id                String   @id @default(cuid())
  code              String   @unique // CP 100, CP 200, CD 19...
  title             String
  category          String   // Contraventions, Délits, Crimes, Crimes fédéraux
  fine              Int      // En dollars
  jailTime          Int      @default(0) // En minutes
  secondarySanction String?  // Suspension de permis, confiscation...
  orderIndex        Int      @default(0)

  citationItems     CitationItem[]
}

model Citation {
  id              String         @id @default(cuid())
  citationNumber  String         @unique
  citizenId       String
  citizen         Citizen        @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  officerId       String
  officer         Officer        @relation(fields: [officerId], references: [id])
  location        String?
  notes           String?
  totalFine       Int
  totalJailTime   Int            @default(0)
  status          String         @default("Impayée") // Impayée, Payée, Classée
  createdAt       DateTime       @default(now())

  items           CitationItem[]
}

model CitationItem {
  id              String        @id @default(cuid())
  citationId      String
  citation        Citation      @relation(fields: [citationId], references: [id], onDelete: Cascade)
  penalCodeItemId String
  penalCodeItem   PenalCodeItem @relation(fields: [penalCodeItemId], references: [id])
  count           Int           @default(1)
  fine            Int
  jailTime        Int           @default(0)
}

model ArrestReport {
  id              String   @id @default(cuid())
  reportNumber    String   @unique
  title           String
  location        String
  summary         String
  seizedItems     String?  // Armes, drogues, argent...
  proofUrls       String?  // Liens d'images / vidéos
  status          String   @default("Clos") // En cours, Clos, Transmis Parquet
  officerId       String
  officer         Officer  @relation(fields: [officerId], references: [id])
  citizenId       String
  citizen         Citizen  @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Warrant {
  id              String    @id @default(cuid())
  warrantNumber   String    @unique
  type            String    @default("WARRANT") // WARRANT (mandat d'arrêt), BOLO_PERSON, BOLO_VEHICLE
  title           String
  description     String
  dangerLevel     String    @default("Dangereux") // Modéré, Dangereux, Armé et dangereux
  status          String    @default("Actif") // Actif, Exécuté, Annulé, Expiré
  officerId       String
  officer         Officer   @relation(fields: [officerId], references: [id])
  citizenId       String?
  citizen         Citizen?  @relation(fields: [citizenId], references: [id], onDelete: SetNull)
  vehiclePlate    String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
}

model RegisteredVehicle {
  id              String   @id @default(cuid())
  plate           String   @unique
  model           String
  color           String
  status          String   @default("En règle") // En règle, Volé, BOLO / Recherché, Fourrière
  notes           String?
  ownerId         String?
  owner           Citizen? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RegisteredWeapon {
  id              String   @id @default(cuid())
  serialNumber    String   @unique
  weaponType      String   // Pistolet, Fusil, Automatique, etc.
  modelName       String
  status          String   @default("En règle") // En règle, Volée, Confisquée, Recherche
  notes           String?
  ownerId         String?
  owner           Citizen? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Investigation {
  id              String   @id @default(cuid())
  caseNumber      String   @unique
  title           String
  summary         String
  status          String   @default("Ouvert") // Ouvert, En cours, Transmis Justice, Clos
  dangerLevel     String   @default("Moyen")
  leadOfficerId   String
  leadOfficer     Officer  @relation(fields: [leadOfficerId], references: [id])
  suspects        String?  // Liste ou IDs de suspects
  evidence        String?  // Rapport de preuves / photos / saisies
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TrainingCourse {
  id               String   @id @default(cuid())
  title            String
  description      String
  category         String   // Conduite, Tactique, Aérien, Spécialité, Procédure
  badgeName        String
  badgeIcon        String   @default("Award")
  prerequisiteRank String?  // Grade minimum
  creatorId        String?
  creator          Officer? @relation(fields: [creatorId], references: [id])
  createdAt        DateTime @default(now())

  sessions         TrainingSession[]
  awardedBadges    OfficerBadge[]
}

model TrainingSession {
  id              String   @id @default(cuid())
  courseId        String
  course          TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructorId    String
  instructor      Officer  @relation(fields: [instructorId], references: [id])
  scheduledAt     DateTime
  location        String
  maxSeats        Int      @default(6)
  status          String   @default("Planifiée") // Planifiée, En cours, Terminée, Annulée
  notes           String?
  createdAt       DateTime @default(now())

  registrations   TrainingRegistration[]
}

model TrainingRegistration {
  id              String   @id @default(cuid())
  sessionId       String
  session         TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  officerId       String
  officer         Officer  @relation(fields: [officerId], references: [id], onDelete: Cascade)
  status          String   @default("Inscrit") // Inscrit, Validé, Échoué, Absent
  notes           String?
  registeredAt    DateTime @default(now())
  completedAt     DateTime?
}

model OfficerBadge {
  id              String         @id @default(cuid())
  officerId       String
  officer         Officer        @relation(fields: [officerId], references: [id], onDelete: Cascade)
  courseId        String
  course          TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  awardedAt       DateTime       @default(now())
  awardedBy       String?
}

model RadioCodeReference {
  id              String   @id @default(cuid())
  codeType        String   // TEN_CODE, UNIT_CALLSIGN, URGENCY_CODE, PROCEDURE
  code            String
  title           String
  description     String?
  orderIndex      Int      @default(0)
}

model DiscordSetting {
  id               String   @id @default("default")
  botToken         String?
  guildId          String?
  clientId         String?  // Discord Application Client ID
  clientSecret     String?  // Discord Application Client Secret
  welcomeChannelId String?
  autoSyncRoles    Boolean  @default(true)
  sendWelcomeDm    Boolean  @default(true)
  authRequired     Boolean  @default(true) // Requiert une connexion Discord pour accéder au terminal
  allowedRoles     String?  // Rôles autorisés (ex: "LSPD,Police,Rookie,Officier I,Officier II...")
  roleMappings     String?  // JSON stringified role mapping { "Chief of Police": "role_id", ... }
  updatedAt        DateTime @updatedAt
}

model RecruitmentCandidate {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  phone              String?
  discordTag         String?
  discordId          String?
  discordAvatar      String?
  age                Int?
  availability       String?
  motivation         String?
  experience         String?
  customAnswers      String?   // JSON string storing answers to form fields: { [fieldIdOrName: string]: any }
  status             String    @default("En attente") // En attente, Entretien prévu, Accepté, Refusé
  interviewDate      DateTime?
  interviewNotes     String?
  decisionReason     String?
  discordRoleGranted Boolean   @default(false)
  discordNotified    Boolean   @default(false)
  recruiterId        String?
  recruiter          Officer?  @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model RecruitmentFormField {
  id          String   @id @default(cuid())
  label       String   // Intitulé de la question
  name        String   // Clé d'identification unique
  type        String   @default("text") // text, textarea, number, select, radio, checkbox
  placeholder String?
  options     String?  // Options pour select/radio (séparées par des virgules)
  helpText    String?  // Description ou consigne d'aide sous le champ
  required    Boolean  @default(false)
  orderIndex  Int      @default(0)
  enabled     Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
